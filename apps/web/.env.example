# 服务端默认模型（全部可选）。
# 一般不需要配置：打开网页，点右上角“模型设置”填写即可，配置只保存在浏览器本地。
# 如果要部署公共实例，让访问者不填写也能使用，可在这里配置默认模型。
# 复制为 .env.local 后填写；.env.local 已被 .gitignore 忽略，不会提交到仓库。

# 任意 OpenAI 兼容接口
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 翻译、检索改写、Agent 等高频任务用的模型，留空则与 LLM_MODEL 相同
LLM_FAST_MODEL=
# 框选讲解图表 / 公式用的视觉模型（需支持图片输入），留空则该功能不可用
LLM_VISION_MODEL=
# 附加到请求体的 JSON 参数（可选），例如关闭快速模型的思考模式：{"enable_thinking":false}
LLM_EXTRA_BODY=
LLM_FAST_EXTRA_BODY=

# 学者 Agent 的 Semantic Scholar 密钥（可选），配置后可减少限流：https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# 端侧向量模型的下载源（可选），访问 HuggingFace 较慢时可改为镜像站
NEXT_PUBLIC_HF_ENDPOINT=
