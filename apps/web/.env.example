# 大模型（OpenAI 兼容接口），以 DeepSeek 为例；通义千问、智谱等改 BASE_URL 与 MODEL 即可
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 翻译、查询改写等高频任务可用更便宜的模型，留空则与 LLM_MODEL 相同
LLM_FAST_MODEL=
# 附加到请求体的 JSON 参数（可选）。例如阿里云百炼的思考模型，关闭快速任务的思考可明显降低翻译延迟：
# LLM_FAST_EXTRA_BODY={"enable_thinking":false}
# 框选图表 / 公式讲解用的视觉模型（需支持图片输入），例如百炼的 qwen3-vl-plus；留空则该功能不可用
LLM_VISION_MODEL=
LLM_EXTRA_BODY=
LLM_FAST_EXTRA_BODY=

# 端侧 embedding 模型的下载源，国内网络可设为 https://hf-mirror.com
NEXT_PUBLIC_HF_ENDPOINT=
